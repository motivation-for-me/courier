# Supabase pooled runtime connection (use the pooler URL for the API).
DATABASE_URL=
# Supabase direct database connection (use the direct URL for Prisma migrations).
DIRECT_URL=
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-key
NODE_ENV=production
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=courier-documents
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
APP_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
# Optional local target for the Next.js /api proxy. Vercel injects
# API_INTERNAL_URL from the service binding; never configure it in Vercel.
API_ORIGIN=http://localhost:3001

# Temporarily preserve legacy account/password sign-in. Enable after account setup.
GOOGLE_AUTH_ENABLED=false
ACCOUNT_EMAIL_ENABLED=false
REQUIRE_EMAIL_VERIFICATION=false
