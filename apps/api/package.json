{
  "name": "@courier/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "generate": "prisma generate --schema ../../prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "prebuild": "npm run generate",
    "build": "npm run migrate:deploy && nest build",
    "vercel-build": "npm run build",
    "start": "node dist/main.js",
    "bootstrap:admin": "node dist/scripts/bootstrap-admin.js",
    "sync:permissions": "node dist/scripts/sync-admin-permissions.js",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "test": "node --test --require ts-node/register test/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "pdfkit": "0.17.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
